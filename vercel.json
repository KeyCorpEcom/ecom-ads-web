{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sav",
      "destination": "https://sav-web.vercel.app/sav"
    },
    {
      "source": "/sav/:path*",
      "destination": "https://sav-web.vercel.app/sav/:path*"
    },
    {
      "source": "/hub",
      "destination": "https://keycorppnl.vercel.app/hub"
    },
    {
      "source": "/hub/:path*",
      "destination": "https://keycorppnl.vercel.app/hub/:path*"
    }
  ]
}
